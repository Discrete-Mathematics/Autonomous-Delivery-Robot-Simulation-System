<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="delivery_world">
    <!-- 地面和灯光 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 站点1：和小车同大小，坐标(3, 0) -->
    <model name="station_1">
      <static>true</static>
      <pose>3.0 0.0 0.1 0 0 0</pose> <!-- 高度抬到0.1，避免贴地消失 -->
      <link name="link">
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="green">
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 站点2：和小车同大小，坐标(3, 3) -->
    <model name="station_2">
      <static>true</static>
      <pose>3.0 3.0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="green">
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 站点3：和小车同大小，坐标(0, 3) -->
    <model name="station_3">
      <static>true</static>
      <pose>0.0 3.0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="green">
            <ambient>0 0.8 0 1</ambient>
            <diffuse>0 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 障碍物1：和小车同大小，坐标(1.5, 0) -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>1.5 0.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="red">
            <ambient>0.8 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 障碍物2：和小车同大小，坐标(3, 1.5) -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>3.0 1.5 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="red">
            <ambient>0.8 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 障碍物3：和小车同大小，坐标(1.5, 3) -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>1.5 3.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box size="0.4 0.3 0.2"/>
          </geometry>
          <material name="red">
            <ambient>0.8 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 物理引擎优化 -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200.0</real_time_update_rate>
    </physics>

  </world>
</sdf>